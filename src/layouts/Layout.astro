---
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/global.css";

interface LayoutProps {
  title: string;
}

const { title = "" }: LayoutProps = Astro.props;

const titleToShow = title ? `- ${title}` : "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg" href="/favicon.svg" />
    <meta
      name="description"
      content="Nagare - Ofrecemos soluciones digitales para empresas y particulares"
    />
    <meta
      name="keywords"
      content="nagare, desarrollo web, diseño gráfico, marketing digital, soluciones digitales"
    />
    <meta name="author" content="Nagare Creative Studio" />
    <title>Nagare {titleToShow}</title>
    <ClientRouter />
    <link rel="preload" href="/fonts/SourceSerif4.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/EtherealDemo-Black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="bg-neutral font-text animate-blurred-fade-in">
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  /* prevent that body can be scrolleable with the navbar open */
  body:has(#menu:checked) {
    overflow: hidden;
  }
</style>

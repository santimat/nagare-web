---
interface Props {
  parent: string;
}

const { parent } = Astro.props;
---

<div
  data-parent={parent}
  id="menu-backdropardo"
  class={`
      absolute bg-accent/40 backdrop-blur-xs rounded-xl
      translate-x-(--left) translate-y-(--top)
      inset-0
      w-(--width) h-(--height)
      transition-all duration-500
      ease-in-out opacity-0
      -z-10
    `}
>
</div>

<script>
  const initialize = () => {
    if (window.matchMedia("(min-width: 768px)").matches) {
      const $menuBackDrop = document.querySelector("#menu-backdropardo") as HTMLElement;
      const parentSelector = $menuBackDrop.dataset.parent;
      const $parent = document.querySelector(parentSelector) as HTMLElement;
      console.log({ parentSelector, $parent });
      const updateMenuBackDrop = ({ target: $hoveredElement }) => {
        if ($hoveredElement instanceof HTMLLIElement) {
          const { left, top, width, height } = $hoveredElement.getBoundingClientRect();

          // Object assign to update multiple styles at once
          Object.assign($menuBackDrop.style, {
            transform: `translate(${left}px, ${top}px)`,
            width: `${width}px`,
            height: `${height}px`,
            opacity: "1",
            visibility: "visible",
          });
        }
      };

      const resetMenuBackDrop = () => {
        Object.assign($menuBackDrop.style, {
          opacity: "0",
          visibility: "hidden",
        });
      };

      $parent?.addEventListener("mouseover", updateMenuBackDrop);
      $parent?.addEventListener("mouseleave", resetMenuBackDrop);

      document.addEventListener(
        "astro:before-swap",
        () => {
          $parent?.removeEventListener("mouseenter", updateMenuBackDrop);
          $parent?.removeEventListener("mouseleave", resetMenuBackDrop);
        },
        { once: true },
      );
    }
  };

  document.addEventListener("astro:page-load", initialize);
</script>

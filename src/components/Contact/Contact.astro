---
import { Image } from "astro:assets";
import CharacterImage from "@/icons/CharacterIcon.astro";
import ContactForm from "@/components/Contact/ContactForm.astro";
import Toast from "@/components/Toast.tsx";
---

<main class="relative mt-5 mb-10 h-full">
  <Toast client:load />
  <div class="text-neutral bg-main relative mx-auto w-11/12 rounded-xl p-4 shadow-xl lg:max-w-4xl">
    <h1 class="font-heading mb-4 text-center text-5xl font-semibold">Formulario de contacto</h1>
    <ContactForm />
  </div>
</main>
